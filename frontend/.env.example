# Use the built-in mock backend. Set to false to talk to Django.
VITE_USE_MOCKS=true

# Django API base (used when VITE_USE_MOCKS=false)
VITE_API_URL=/api/v1

# Django admin URL for the "Admin" nav item
VITE_ADMIN_URL=http://localhost:8000/admin/

# OpenAPI schema URL for `npm run api:types`
VITE_OPENAPI_URL=http://localhost:8000/api/schema/
