# Mock backend. Default is off so production builds talk to Django.
# Set to true only for local UI work without a backend.
VITE_USE_MOCKS=false

# Django API base (same-origin /api/v1 by default, proxied by nginx)
VITE_API_URL=/api/v1

# Django admin URL for the "Admin" nav item
VITE_ADMIN_URL=/admin/

# OpenAPI schema URL for `npm run api:types`
VITE_OPENAPI_URL=/api/schema/
