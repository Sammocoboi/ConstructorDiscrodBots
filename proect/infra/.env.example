# PostgreSQL (используется сервисами db и migrate)
POSTGRES_DB=constructor
POSTGRES_USER=constructor
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Runtime
DATABASE_URL=postgresql://constructor:change-me@db:5432/constructor
WORKER_ID=runtime-1
LOG_LEVEL=INFO
MAX_BOTS_PER_WORKER=25
HEARTBEAT_INTERVAL=15
RECONCILE_INTERVAL=10
COMMAND_POLL_INTERVAL=30
RESTART_LIMIT=5
RUNTIME_PORT=8080

# 32-байтный ключ AES-256-GCM в base64. Должен совпадать с ключом backend.
# Сгенерировать: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
BOT_TOKEN_ENCRYPTION_KEY=

# Необязательно: Sentry (нужен extra observability, он уже включён в Docker-образ)
SENTRY_DSN=

# Необязательно: ручная проверка на тестовом Discord-сервере
DISCORD_TEST_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=
