# Production stack. Copy to `.env` and fill every required value.
# Generate TOKEN_ENCRYPTION_KEY:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# Domains / TLS (Caddy obtains certificates automatically)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Django
DJANGO_SECRET_KEY=replace-with-long-random-value
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_DEBUG=false

# PostgreSQL (internal only; not published by docker-compose.prod.yml)
POSTGRES_DB=constructor
POSTGRES_USER=constructor
POSTGRES_PASSWORD=replace-with-long-random-value

# Shared by backend and Runtime. URL-safe base64 of exactly 32 bytes.
TOKEN_ENCRYPTION_KEY=

# Frontend / CORS
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.example.com/api/v1/auth/discord/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Runtime
WORKER_ID=runtime-1
LOG_LEVEL=INFO
MAX_BOTS_PER_WORKER=25
HEARTBEAT_INTERVAL=15
RECONCILE_INTERVAL=10
COMMAND_POLL_INTERVAL=30
RESTART_LIMIT=5
SENTRY_DSN=

# Optional services / operations
IMAGE_TAG=latest
PROMETHEUS_PORT=9090
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
