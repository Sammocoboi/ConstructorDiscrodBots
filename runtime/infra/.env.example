# PostgreSQL already running the Django schema. The root dev compose publishes
# 5432 on localhost; from a Runtime container use host.docker.internal.
DATABASE_URL=postgresql://constructor:change-me@host.docker.internal:5432/constructor

# Runtime
WORKER_ID=runtime-1
LOG_LEVEL=INFO
MAX_BOTS_PER_WORKER=25
HEARTBEAT_INTERVAL=15
RECONCILE_INTERVAL=10
COMMAND_POLL_INTERVAL=30
RESTART_LIMIT=5
RUNTIME_PORT=8080

# Shared with backend. URL-safe base64 of exactly 32 bytes.
# Generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# Optional: Sentry (extra observability is installed in the Docker image)
SENTRY_DSN=
