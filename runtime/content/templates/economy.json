      "activity": {"type": "playing", "text": "экономику"}
    },
    "modules": [
      {"id": "economy", "enabled": true, "settings": {"currency": "монеты"}}
    ],
    "commands": [
      {"id": "cmd_balance", "name": "balance", "description": "Показать баланс", "flow_id": "flow_balance", "options": []},
      {"id": "cmd_daily", "name": "daily", "description": "Получить ежедневный бонус", "flow_id": "flow_daily", "options": []}
    ],
    "flows": [
      {
        "id": "flow_balance",
        "trigger": {"type": "slash_command", "command_id": "cmd_balance"},
        "nodes": [
          {"id": "n1", "type": "slash_command", "params": {"command_id": "cmd_balance"}},
          {"id": "n2", "type": "send_message", "params": {
            "content": "Баланс {user.name}: {variables.balance} монет.",
            "ephemeral": true
          }}
        ],
        "edges": [{"from": "n1", "to": "n2"}]
      },
      {
        "id": "flow_daily",
        "trigger": {"type": "slash_command", "command_id": "cmd_daily"},
